# =============================================================================
# .factory.env.example — AI Dev Factory configuration
#
# HOW TO USE (submodule — recommended):
#   git submodule add https://github.com/you/ai-dev-factory tools/ai-dev-factory
#   bash tools/ai-dev-factory/install.sh
#   cp tools/ai-dev-factory/.factory.env.example .factory.env
#   # Edit .factory.env — it lives at repo root and is gitignored.
#
# HOW TO USE (standalone):
#   cp ai-dev-factory/.factory.env.example .factory.env
#   Edit .factory.env for your project.
#
# OVERRIDE AT RUNTIME:
#   make run FEATURE=foo MODEL_SONNET=claude-sonnet-4-5   (one-off override)
#   All Makefile variables can be overridden on the command line.
# =============================================================================


# ── Models ────────────────────────────────────────────────────────────────────
# Haiku:  fast, cheap — mechanical roles (linter, ci/cd, push-to-pr, steward)
# Sonnet: main work — engineer, qa, ux, performance, red team
# Opus:   expensive, best reasoning — architect only (called once per feature)
MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-4-5
MODEL_OPUS=claude-opus-4-6


# ── Loop limits ───────────────────────────────────────────────────────────────
# MAX_LOOP_BACKS: how many times a single gate can fail before pausing for human
MAX_LOOP_BACKS=3

# MAX_AGENT_CALLS: hard ceiling on total agent calls per feature run.
# When hit, the loop pauses and asks for human input.
# A full clean feature run uses ~11–15 calls; 50 allows for loop-backs.
MAX_AGENT_CALLS=50


# ── Local development ─────────────────────────────────────────────────────────
# BASE_URL: where your local dev server runs (used by k6 performance tests)
BASE_URL=http://localhost:3000

# TEST_CMD: command to run your full test suite.
# Leave empty to use auto-detection (detects jest/pytest/go test/rspec).
# Set explicitly if auto-detection fails or you use a custom command.
# Examples:
#   TEST_CMD=npm test
#   TEST_CMD=pytest -x -q
#   TEST_CMD=go test ./...
#   TEST_CMD=bundle exec rspec
TEST_CMD=


# ── Gate control ──────────────────────────────────────────────────────────────
# SKIP_GATES: comma-separated list of gates to bypass for this project.
# Use for backend-only repos (skip ux), API-only (skip performance frontend check), etc.
# Available gates: prd_linter, architect, engineer, qa, ux, performance, cicd, red_team
# Example: SKIP_GATES=ux,performance
# Leave empty to run all gates (recommended).
SKIP_GATES=


# ── Paths ─────────────────────────────────────────────────────────────────────
# Submodule layout (DEFAULT — no changes needed):
#   factory.mk auto-detects its own location and sets all paths relative to it.
#   scripts/, kb/, features/, templates/ all resolve inside the submodule dir.
#   Only .claude/agents/ and CLAUDE.md are placed at repo root by install.sh.
#   You do NOT need to set any path variables for the submodule layout.
#
# Override only if you want features/ or kb/ at a different location, e.g.:
#   FEATURES_DIR=features          # move PRDs to repo-root/features/ instead
#   KB_DIR=docs/kb                 # store KB alongside your product docs
#
# AGENTS_DIR must always point to repo root — Claude Code requires this:
# AGENTS_DIR=.claude/agents


# ── Performance budgets ───────────────────────────────────────────────────────
# These override the defaults in the Performance agent.
# Units: milliseconds for latency, ratio (0–1) for error rate, KB for bundle.
PERF_P95_MS=300
PERF_P99_MS=1000
PERF_ERROR_RATE=0.01
PERF_BUNDLE_KB=20
