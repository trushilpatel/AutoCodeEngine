# =============================================================================
# .factory.env.example — AutoCodeEngine configuration
#
# HOW TO USE (submodule — recommended):
#   git submodule add https://github.com/trushilpatel/AutoCodeEngine tools/autocode
#   bash tools/autocode/install.sh
#   cp tools/autocode/.factory.env.example .factory.env
#   # Edit .factory.env — lives at repo root, gitignored, never committed.
#
# HOW TO USE (standalone):
#   cp tools/autocode/.factory.env.example .factory.env
#
# OVERRIDE AT RUNTIME:
#   make run FEATURE=foo MODEL_SONNET=claude-sonnet-4-5   (one-off override)
#   All Makefile variables can be overridden on the command line.
# =============================================================================


# ── Models ────────────────────────────────────────────────────────────────────
# Haiku:  fast, cheap — linter, ci/cd, ux, push-to-pr, steward
# Sonnet: main work  — engineer, qa, performance, red-team
# Opus:   best reasoning — architect only (called once per feature)
MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-4-5
MODEL_OPUS=claude-opus-4-6


# ── Loop limits ───────────────────────────────────────────────────────────────
# MAX_LOOP_BACKS: retries allowed per gate before the loop pauses for human input
MAX_LOOP_BACKS=3

# MAX_AGENT_CALLS: hard ceiling on total agent calls per feature run.
# A clean feature run uses ~11–15 calls; 50 gives generous room for loop-backs.
MAX_AGENT_CALLS=50


# ── Local development ─────────────────────────────────────────────────────────
# BASE_URL: where your local dev server runs (used by k6 performance tests)
BASE_URL=http://localhost:3000

# TEST_CMD: your full test suite command.
# Leave empty for auto-detection (detects jest / pytest / go test / rspec).
# Examples:
#   TEST_CMD=npm test
#   TEST_CMD=pytest -x -q
#   TEST_CMD=go test ./...
#   TEST_CMD=bundle exec rspec
TEST_CMD=


# ── Gate control ──────────────────────────────────────────────────────────────
# SKIP_GATES: comma-separated gates to bypass for this project type.
# Backend-only:  SKIP_GATES=ux
# API-only:      SKIP_GATES=ux,performance
# Early proto:   SKIP_GATES=performance,red_team
# Available:     prd_linter, architect, engineer, qa, ux, performance, cicd, red_team, push_to_pr
# Leave empty to run all gates (recommended for production features).
SKIP_GATES=


# ── Knowledge base ────────────────────────────────────────────────────────────
# Two-tier KB — both are set automatically; override only if needed.
#
# KB_DIR: your PROJECT knowledge base.
#   Lives at repo root. Committed to YOUR project repo.
#   Contains codebase-specific learnings: your data model quirks, your team's
#   decisions, patterns specific to this stack.
#   Default: kb/  (repo root)
# KB_DIR=kb
#
# ENGINE_KB_DIR: the AutoCodeEngine shared knowledge base.
#   Lives inside the AutoCodeEngine submodule. Auto-set by factory.mk.
#   Contains generalizable patterns that benefit all projects.
#   Steward opens PRs to this repo when it finds engine-level learnings.
#   Override only if your submodule is at a non-standard path:
# ENGINE_KB_DIR=tools/autocode/kb
#
# AGENTS_DIR: must always be .claude/agents/ — Claude Code requires this path.
# AGENTS_DIR=.claude/agents


# ── Performance budgets ───────────────────────────────────────────────────────
# Units: milliseconds for latency, ratio (0–1) for error rate, KB for bundle size.
PERF_P95_MS=300
PERF_P99_MS=1000
PERF_ERROR_RATE=0.01
PERF_BUNDLE_KB=20


# ── Per-agent turn limits (optional overrides) ────────────────────────────────
# Uncomment and adjust if an agent is hitting its ceiling too often.
# TURNS_PRD_LINTER=5
# TURNS_ARCHITECT=15
# TURNS_ENGINEER=20
# TURNS_QA=20
# TURNS_UX=10
# TURNS_PERFORMANCE=15
# TURNS_CICD=6
# TURNS_RED_TEAM=25
# TURNS_PUSH_TO_PR=8
# TURNS_STEWARD=15
